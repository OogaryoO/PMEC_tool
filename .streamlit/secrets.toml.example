# Streamlit 登入設定（st.login，Google OIDC）。
# 本機：複製為 .streamlit/secrets.toml（已被 .gitignore 排除）；
# Cloud Run：整份內容存進 Secret Manager 的 pmec-streamlit-secrets，由 deploy/deploy.sh 掛載。
[auth]
# Cloud Run：https://<服務網址>/oauth2callback；本機：http://localhost:8501/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# 隨機長字串，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "change-me"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "change-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
