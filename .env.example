# ============================================================
# PMEC Tool 環境變數範本
# 使用方式：複製此檔為 .env，並填入實際的密鑰與設定值。
#   cp .env.example .env
# .env 內含機密資訊，切勿提交到版本控制。
# ============================================================

# --- 國網 RAP 平台（相容 OpenAI SDK 的端點） ---
RAP_API_KEY=your_rap_api_key_here
RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_MODEL_NAME=Meta-Llama-3-70B-Instruct

# --- GitHub ---
# GitHub Personal Access Token，需具備 repo (私有倉庫讀取) 權限
GITHUB_TOKEN=your_github_personal_access_token_here
# 目標倉庫，格式為 owner/repo
GITHUB_REPO=your-org/your-repo

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=github_feature_cards

# --- 功能卡片快取（選填，寫回 GitHub repo，避免每次重啟都重新呼叫 RAP LLM 摘要） ---
# CACHE_REPO 留空 = 停用快取。建議指向一個你有寫入權限的 repo
# （可以是本專案自己的 repo，或另外建立的私有小 repo 專門存快取）。
CACHE_ENABLED=true
CACHE_REPO=
CACHE_FILE_PATH=pmec_cache/feature_cards.json
CACHE_BRANCH=

# --- 其他可調參數（可選） ---
PR_FETCH_LIMIT=20
RAG_TOP_K=4
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
