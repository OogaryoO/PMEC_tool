# ============================================================
# PMEC Tool 環境變數範本
# 使用方式：複製此檔為 .env，並填入實際的密鑰與設定值。
#   cp .env.example .env
# .env 內含機密資訊，切勿提交到版本控制。
# ============================================================

# --- 國網 RAP 平台（相容 OpenAI SDK 的端點） ---
RAP_API_KEY=your_rap_api_key_here
RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_MODEL_NAME=Meta-Llama-3-70B-Instruct

# --- GitHub ---
# GitHub Personal Access Token，僅需具備 GITHUB_REPO 的「唯讀」權限
# （fine-grained PAT：Repository access 限定該 repo，Contents: Read-only）。
GITHUB_TOKEN=your_github_personal_access_token_here
# 目標倉庫，格式為 owner/repo
GITHUB_REPO=your-org/your-repo
# 讀寫功能卡片快取（CACHE_REPO）用的 token，需具備該 repo 的「讀寫」權限，
# 刻意與上面 GITHUB_TOKEN 分開，避免 GITHUB_TOKEN 對來源 repo 也帶有寫入權限。
# 留空則 fallback 回 GITHUB_TOKEN（不建議，等同放棄唯讀限制）。
CACHE_GITHUB_TOKEN=your_cache_repo_write_token_here

# --- Google Drive（選填，設定 GDRIVE_FOLDER_IDS 即啟用） ---
# 要同步的資料夾 ID（網址 https://drive.google.com/drive/folders/<ID> 的 <ID>），
# 會連同所有子資料夾一起讀取；多個資料夾以逗號分隔。
# 資料夾需「共用」給 Service Account 的 email（金鑰 JSON 內的 client_email，檢視者即可）；
# 共用雲端硬碟（Shared Drive）則將 Service Account 加為成員（檢視者）。
GDRIVE_FOLDER_IDS=
# Service Account 金鑰：JSON 檔路徑（相對路徑以專案根目錄為準），
# 或直接貼上整份金鑰 JSON（以 { 開頭，請用單引號包住）。GCP 專案需啟用 Google Drive API。
GDRIVE_SERVICE_ACCOUNT_JSON=./secrets/gdrive-service-account.json
# 每次同步最多讀取的檔案數；首次同步每份文件各呼叫一次 RAP 摘要，避免超大資料夾一次耗盡額度。
GDRIVE_MAX_FILES=100

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=github_feature_cards
# 本地 embedding 模型（fastembed 支援的 ONNX 模型）；更換後既有向量資料會自動清空並從快取還原
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- 功能卡片快取（選填，寫回 GitHub repo，避免每次重啟都重新呼叫 RAP LLM 摘要） ---
# CACHE_REPO 留空 = 停用快取。建議指向一個你有寫入權限的 repo
# （可以是本專案自己的 repo，或另外建立的私有小 repo 專門存快取）。
CACHE_ENABLED=true
CACHE_REPO=
CACHE_FILE_PATH=pmec_cache/feature_cards.json
CACHE_BRANCH=

# --- 其他可調參數（可選） ---
PR_FETCH_LIMIT=20
RAG_TOP_K=8
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
