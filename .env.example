# ============================================================
# PMEC Tool 環境變數範本（本機開發用）
# 使用方式：複製此檔為 .env，並填入實際的密鑰與設定值。
#   cp .env.example .env
# .env 內含機密資訊，切勿提交到版本控制。
# 部署在 Cloud Run 時，同名變數由 deploy/deploy.sh 設定，密鑰來自 Secret Manager。
# ============================================================

# --- AI 模型（客戶自選；建議用 python -m src.setup_wizard 產生） ---
# rap | openai | anthropic | openrouter | gemini | ollama | custom
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# 選填：覆蓋預設端點（custom 必填，例如 Azure OpenAI、自架 vLLM）
LLM_BASE_URL=
# 舊設定仍可用（沒有 LLM_PROVIDER 時視為 rap）：RAP_API_KEY / RAP_BASE_URL / RAP_MODEL_NAME

# --- GitHub ---
# GitHub Personal Access Token，僅需具備 GITHUB_REPO 的「唯讀」權限
# （fine-grained PAT：Repository access 限定該 repo，Contents / Pull requests: Read-only）。
GITHUB_TOKEN=your_github_personal_access_token_here
# 目標倉庫，格式為 owner/repo
GITHUB_REPO=your-org/your-repo

# --- 資料庫（PostgreSQL，需安裝 pgvector） ---
# 本機可用 `python scripts/dev_db.py` 啟動內嵌 PostgreSQL 並印出連線字串。
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pmec
# 本地 embedding 模型（fastembed 支援的 ONNX 模型，需為 384 維）；更換後執行 `python -m src.worker reembed`
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Google Drive（選填，設定 GDRIVE_FOLDER_IDS 即啟用） ---
# 要同步的資料夾 ID（網址 https://drive.google.com/drive/folders/<ID> 的 <ID>），
# 會連同所有子資料夾一起讀取；多個資料夾以逗號分隔。
# 資料夾需「共用」給 Service Account 的 email（檢視者即可）。
GDRIVE_FOLDER_IDS=
# 本機開發的 Google 憑證：指向 Service Account 金鑰檔（Cloud Run 上不需要，使用服務掛載的身分）。
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gdrive-service-account.json
# 每次同步最多讀取的檔案數；首次同步每份文件各呼叫一次 RAP 摘要，避免超大資料夾一次耗盡額度。
GDRIVE_MAX_FILES=100

# --- 登入 ---
# google | microsoft | cloudflare
AUTH_MODE=google
# AUTH_MODE=microsoft：公司自己的 Entra 租用戶 ID
ENTRA_TENANT_ID=
# AUTH_MODE=cloudflare：Zero Trust 團隊網域與 Access 應用程式的 AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# 個別允許的 email（逗號分隔）
ALLOWED_EMAILS=
# 允許登入的公司網域（逗號分隔）；未設定則任何人都無法登入。
ALLOWED_EMAIL_DOMAINS=example.com
# 管理員（可觸發同步、看連線設定與錯誤細節）
ADMIN_EMAILS=admin@example.com
# 本機開發略過登入（Cloud Run 上一律無效）。Google 登入設定見 .streamlit/secrets.toml.example
AUTH_DISABLED=true

# --- 其他可調參數（可選） ---
PR_FETCH_LIMIT=20
RAG_TOP_K=8
# LLM_TEMPERATURE=   # 留空＝不送（目前的 Claude、GPT 推理模型不接受）；RAP 預設 0.2
LLM_REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

# 企業設定檔（連接器、權限、排除規則、階段）；未設定時讀專案根目錄的 tenant.toml，兩者都沒有則用預設值
# TENANT_CONFIG=tenant.toml

# --- 試用版／地端版（docker compose、scripts/local_stack.sh） ---
# SYNC_MODE=queue
# DB_WORKER_PASSWORD=
# DB_APP_PASSWORD=
# TUNNEL_TOKEN=          # Cloudflare Tunnel
# M365_CLIENT_SECRET=    # Microsoft 365 連接器
