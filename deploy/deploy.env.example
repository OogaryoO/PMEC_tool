# 部署設定（非機密）。複製為 deploy/deploy.env 後填入，deploy/*.sh 會讀取。
# 密碼、API key 不寫在這裡：gcp_setup.sh 會提示輸入並存進 Secret Manager。
GCP_PROJECT=your-gcp-project
GCP_REGION=asia-east1

# 資料庫：
#   cloudsql ＝建立 Cloud SQL（要錢；企業雲版）
#   external ＝用外部 PostgreSQL（需 pgvector），例如 Neon 免費方案（雲端版）。
#              gcp_setup.sh 會請你貼上連線字串（schema 擁有者帳號），只存在 Secret Manager。
DB_MODE=cloudsql
SQL_INSTANCE=pmec-db
# Cloud SQL 機型；db-g1-small 約 1.7GB RAM（DB_MODE=cloudsql 才用）
SQL_TIER=db-g1-small
DB_NAME=pmec

# AI 模型（客戶自選；見 src/llm.py）：rap | openai | anthropic | openrouter | gemini | custom
# API key 由 gcp_setup.sh 提示輸入（Secret Manager：pmec-llm-api-key）
LLM_PROVIDER=openai
LLM_MODEL=
# 選填：覆蓋預設端點（custom 必填）
LLM_BASE_URL=

# 資料來源
GITHUB_REPO=your-org/your-repo
GDRIVE_FOLDER_IDS=
GDRIVE_MAX_FILES=100

# 登入
ALLOWED_EMAIL_DOMAINS=your-company.com
ALLOWED_EMAILS=
ADMIN_EMAILS=you@your-company.com
# 每日自動同步時間（cron，台北時間）
SYNC_SCHEDULE="0 3 * * *"
