# 部署設定（非機密）。複製為 deploy/deploy.env 後填入，deploy/*.sh 會讀取。
GCP_PROJECT=belld-brain
GCP_REGION=asia-east1
SQL_INSTANCE=pmec-db
# Cloud SQL 機型；db-g1-small 約 1.7GB RAM
SQL_TIER=db-g1-small
DB_NAME=pmec

# 應用程式設定
GITHUB_REPO=BellTech-organization/BellD-Web-V2
GDRIVE_FOLDER_IDS=
GDRIVE_MAX_FILES=100
RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_MODEL_NAME=Llama-3.3-70B-Instruct
ALLOWED_EMAIL_DOMAINS=your-company.com
ADMIN_EMAILS=you@your-company.com
# 每日自動同步時間（cron，台北時間）
SYNC_SCHEDULE=0 3 * * *
